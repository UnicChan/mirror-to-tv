$screenPreview.Add_Paint({
    param($sender, $eventArgs)
    try {
        $graphics = $eventArgs.Graphics
        $graphics.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
        $gridPen = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(24, 62, 211, 238), 1)
        $framePen = New-Object System.Drawing.Pen($script:ThemeBorder, 1)
        try {
            for ($gridX = 160; $gridX -lt 640; $gridX += 160) { $graphics.DrawLine($gridPen, $gridX, 0, $gridX, 360) }
            for ($gridY = 90; $gridY -lt 360; $gridY += 90) { $graphics.DrawLine($gridPen, 0, $gridY, 640, $gridY) }
            $graphics.DrawRectangle($framePen, 0, 0, 639, 359)
        } finally { $gridPen.Dispose(); $framePen.Dispose() }

        if ($script:MediaItems.Count -eq 0) {
            $font = New-Object System.Drawing.Font('Consolas', 12)
            $brush = New-Object System.Drawing.SolidBrush($script:ThemeMuted)
            try { $graphics.DrawString('ADD MEDIA TO BEGIN', $font, $brush, 215, 166) }
            finally { $font.Dispose(); $brush.Dispose() }
            return
        }

        $shadowBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(100, 0, 0, 0))
        $selectedBorderPen = New-Object System.Drawing.Pen($script:ThemeAccent, 2)
        $normalBorderPen = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(135, 126, 145, 171), 1)
        $handleBrush = New-Object System.Drawing.SolidBrush($script:ThemeAccent)
        $handlePen = New-Object System.Drawing.Pen([System.Drawing.Color]::White, 2)
        $deleteBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(185, 244, 76, 106))
        $buttonBorder = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(225, 255, 255, 255), 1.5)
        $buttonFont = New-Object System.Drawing.Font('Segoe UI Semibold', 8)
        $buttonTextBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::White)
        $buttonFormat = New-Object System.Drawing.StringFormat
        $buttonFormat.Alignment = [System.Drawing.StringAlignment]::Center
        $buttonFormat.LineAlignment = [System.Drawing.StringAlignment]::Center
        try {
            foreach ($item in @($script:MediaItems)) {
                $rect = Get-MediaItemRectangle $item
                $shadow = [System.Drawing.RectangleF]::new(
                    [single]($rect.X + 5), [single]($rect.Y + 5),
                    [single]$rect.Width, [single]$rect.Height)
                $graphics.FillRectangle($shadowBrush, $shadow)
                $graphics.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
                $graphics.DrawImage($item.Image, $rect)
                $isSelected = [object]::ReferenceEquals($item, $script:SelectedMediaItem)
                $graphics.DrawRectangle($(if ($isSelected) { $selectedBorderPen } else { $normalBorderPen }),
                    $rect.X, $rect.Y, $rect.Width, $rect.Height)

                $deleteRectangle = Get-DeleteRectangle $item
                $graphics.FillEllipse($deleteBrush, $deleteRectangle)
                $graphics.DrawEllipse($buttonBorder, $deleteRectangle)
                $graphics.DrawString('×', $buttonFont, $buttonTextBrush, $deleteRectangle, $buttonFormat)

                if ($item.Kind -eq 'video') {
                    $muteRectangle = Get-VideoMuteRectangle $item
                    $muteBrush = New-Object System.Drawing.SolidBrush(
                    $(if ($item.VideoMuted) {
                        [System.Drawing.Color]::FromArgb(225, 185, 55, 55)
                    } else {
                        [System.Drawing.Color]::FromArgb(225, 35, 42, 52)
                    }))
                    try {
                        $graphics.FillEllipse($muteBrush, $muteRectangle)
                        $graphics.DrawEllipse($buttonBorder, $muteRectangle)
                        $muteText = if ($item.VideoMuted) { 'OFF' } else { 'VOL' }
                        $graphics.DrawString($muteText, $buttonFont, $buttonTextBrush, $muteRectangle, $buttonFormat)
                    } finally { $muteBrush.Dispose() }
                }

                if ($isSelected) {
                    $handleRadius = 7.0
                    $handleDiameter = $handleRadius * 2.0
                    foreach ($point in @(
                        @($rect.Left, $rect.Top), @($rect.Right, $rect.Top),
                        @($rect.Left, $rect.Bottom), @($rect.Right, $rect.Bottom))) {
                        $handleX = [single]([double]$point[0] - $handleRadius)
                        $handleY = [single]([double]$point[1] - $handleRadius)
                        $graphics.FillEllipse($handleBrush, $handleX, $handleY, [single]$handleDiameter, [single]$handleDiameter)
                        $graphics.DrawEllipse($handlePen, $handleX, $handleY, [single]$handleDiameter, [single]$handleDiameter)
                    }
                }
            }
        } finally {
            $shadowBrush.Dispose()
            $selectedBorderPen.Dispose()
            $normalBorderPen.Dispose()
            $handleBrush.Dispose()
            $handlePen.Dispose()
            $deleteBrush.Dispose()
            $buttonBorder.Dispose()
            $buttonFont.Dispose()
            $buttonTextBrush.Dispose()
            $buttonFormat.Dispose()
        }
    } catch {
        # WinForms otherwise opens an intrusive JIT dialog for an exception in Paint.
        $script:LastPaintError = $_.Exception.Message
        try {
            $errorFont = New-Object System.Drawing.Font('Segoe UI', 11)
            $errorBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(230, 220, 225, 235))
            try { $eventArgs.Graphics.DrawString('Preview rendering failed.', $errorFont, $errorBrush, 205, 165) }
            finally { $errorFont.Dispose(); $errorBrush.Dispose() }
        } catch { }
    }
})

$screenPreview.Add_MouseDown({
    param($sender, $eventArgs)
    if ($eventArgs.Button -ne [System.Windows.Forms.MouseButtons]::Left -or $script:MediaItems.Count -eq 0) { return }
    for ($index = $script:MediaItems.Count - 1; $index -ge 0; $index--) {
        $hitItem = $script:MediaItems[$index]
        $deleteRectangle = Get-DeleteRectangle $hitItem
        if ($deleteRectangle.Contains([single]$eventArgs.X, [single]$eventArgs.Y)) {
            Remove-MediaItem $hitItem
            return
        }
        $muteRectangle = Get-VideoMuteRectangle $hitItem
        if (-not $muteRectangle.IsEmpty -and $muteRectangle.Contains([single]$eventArgs.X, [single]$eventArgs.Y)) {
            Select-MediaItem $hitItem
            Toggle-VideoMute
            return
        }
    }
    $resizeHandle = Get-ResizeHandle $eventArgs.X $eventArgs.Y
    if (Start-PreviewResize $resizeHandle) {
        $screenPreview.Capture = $true
        $screenPreview.Cursor = Get-PreviewCursor $eventArgs.X $eventArgs.Y
        Notify-MotionStart
        return
    }
    $hitItem = Get-MediaItemAtPoint $eventArgs.X $eventArgs.Y
    if ($null -ne $hitItem) { Select-MediaItem $hitItem }
    if (Start-PreviewDrag $eventArgs.X $eventArgs.Y) {
        $screenPreview.Capture = $true
        $screenPreview.Cursor = [System.Windows.Forms.Cursors]::SizeAll
        Notify-MotionStart
    }
})

$screenPreview.Add_MouseMove({
    param($sender, $eventArgs)
    if ($script:Resizing) {
        [void](Update-PreviewResize $eventArgs.X $eventArgs.Y)
        return
    }
    if ($script:Dragging) {
        [void](Update-PreviewDrag $eventArgs.X $eventArgs.Y)
        return
    }
    $screenPreview.Cursor = Get-PreviewCursor $eventArgs.X $eventArgs.Y
})

$screenPreview.Add_MouseUp({
    param($sender, $eventArgs)
    if ($script:Dragging -or $script:Resizing) {
        $script:Dragging = $false
        $script:Resizing = $false
        $script:ResizeCorner = ''
        $screenPreview.Capture = $false
        $screenPreview.Cursor = Get-PreviewCursor $eventArgs.X $eventArgs.Y
        Save-Config
        Queue-FinalMove
    }
})

$screenPreview.Add_MouseLeave({
    if (-not $script:Dragging -and -not $script:Resizing) { $screenPreview.Cursor = [System.Windows.Forms.Cursors]::Default }
})

$screenPreview.Add_MouseEnter({ $screenPreview.Focus() })
$screenPreview.Add_MouseWheel({
    param($sender, $eventArgs)
    $step = if ($eventArgs.Delta -gt 0) { 3 } else { -3 }
    $script:OverlaySize = [Math]::Max(1, [Math]::Min(100, $script:OverlaySize + $step))
    Sync-SelectedMediaItem
    Clamp-OverlayPosition
    Mark-PositionDirty
    $screenPreview.Invalidate()
    if ($script:Connected) { Pump-MoveStream $false }
    Queue-FinalMove
})

$opacitySlider.Add_ValueChanged({
