function Send-MediaItem($Item, [bool]$Quiet = $false) {
    if ($null -eq $Item -or -not (Test-Path -LiteralPath $Item.Path -PathType Leaf)) {
        if (-not $Quiet) { Set-Status 'Select an image, GIF, or video first.' ([System.Drawing.Color]::Firebrick) }
        return
    }
    if (-not $script:BroadcastEnabled) {
        if (-not $Quiet) { Set-Status 'The layer is available in the preview only. Enable broadcasting to show it on the TV.' ([System.Drawing.Color]::FromArgb(70, 78, 92)) }
        return
    }
    if ($Item -eq $script:SelectedMediaItem) { Sync-SelectedMediaItem }
    $fileInfo = Get-Item -LiteralPath $Item.Path
    $maximumBytes = if ($Item.Kind -eq 'image') { 12MB } else { 150MB }
    if ($fileInfo.Length -gt $maximumBytes) {
        if (-not $Quiet) { Set-Status "The file is too large. Maximum size: $([Math]::Round($maximumBytes / 1MB)) MB." ([System.Drawing.Color]::Firebrick) }
        return
    }
    if (-not $Quiet) { Set-Status 'Connecting and sending media to the TV.' ([System.Drawing.Color]::FromArgb(70, 78, 92)) }
    $hadAudioSession = $script:AudioSessionActive
    try {
        if ($Item -eq $script:SelectedMediaItem) { Reset-MoveStream }
        $transferPath = [string]$Item.Path
        if ($Item.ChromaEnabled) {
            if (-not $Quiet) { Set-Status 'Preparing chroma-key transparency on the desktop.' ([System.Drawing.Color]::FromArgb(70, 78, 92)) }
            $transferPath = Get-ChromaProcessedFile $Item
        }
        $transferInfo = Get-Item -LiteralPath $transferPath
        $transferMaximumBytes = if ($Item.Kind -eq 'image') { 12MB } else { 150MB }
        if ($transferInfo.Length -gt $transferMaximumBytes) {
            throw "The processed file is too large. Maximum size: $([Math]::Round($transferMaximumBytes / 1MB)) MB."
        }
        Open-AdbTunnel
        Ensure-TVReceiver
        Configure-TVVSync
        Configure-TVAudio
        $x = [Math]::Round([double]$Item.X * 1000)
        $y = [Math]::Round([double]$Item.Y * 1000)
        $width = [int]$Item.Size * 10
        $opacity = [int]$Item.Opacity
        $extension = [System.IO.Path]::GetExtension($transferPath).TrimStart('.').ToLowerInvariant()
        $aspect = [Math]::Round([double]$Item.Aspect * 1000)
        if ($Item.Kind -eq 'gif') {
            $path = "/show-media?id=$($Item.Id)&type=gif&ext=gif&x=$x&y=$y&w=$width&opacity=$opacity&aspect=$aspect"
        } elseif ($Item.Kind -eq 'video') {
            $videoMutedValue = if ($Item.VideoMuted) { 1 } else { 0 }
            $alphaPackedValue = if ($Item.ChromaEnabled) { 1 } else { 0 }
            $path = "/show-media?id=$($Item.Id)&type=video&ext=$extension&x=$x&y=$y&w=$width&opacity=$opacity&aspect=$aspect&videoMuted=$videoMutedValue&alphaPacked=$alphaPackedValue"
        } else {
            $path = "/show?id=$($Item.Id)&x=$x&y=$y&w=$width&opacity=$opacity"
        }
        Send-FileRequest $path $transferPath | Out-Null
        $Item.RemoteVisible = $true
        $script:Connected = $true
        $script:OverlayActive = $true
        $script:PositionDirty = $false
        $script:MoveFailures = 0
        $Item.VideoPaused = $false
        if ($Item -eq $script:SelectedMediaItem) { $script:VideoPaused = $false }
        $heartbeat.Start()
        $positionStreamTimer.Start()
        Save-Config
        if (-not $Quiet) { Set-Status "Broadcasting $($script:MediaItems.Count) layer(s). The selected layer can be positioned independently." ([System.Drawing.Color]::FromArgb(55, 125, 80)) }
    } catch {
        $Item.RemoteVisible = $false
        $script:OverlayActive = @($script:MediaItems | Where-Object { $_.RemoteVisible }).Count -gt 0
        if (-not $script:OverlayActive) { $positionStreamTimer.Stop() }
        if ($hadAudioSession -or $script:OverlayActive) {
            $script:Connected = $true
            $script:AudioSessionActive = $hadAudioSession
            $heartbeat.Start()
        } else {
            $script:Connected = $false
            $script:AudioSessionActive = $false
            $heartbeat.Stop()
            Close-AdbTunnel
        }
        if (-not $Quiet) { Set-Status "Could not display the layer: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick) }
    }
}

function Send-CurrentMedia([bool]$Quiet = $false) {
    Send-MediaItem $script:SelectedMediaItem $Quiet
}

function Hide-And-Disconnect([bool]$Quiet = $false) {
    $heartbeat.Stop()
    $positionStreamTimer.Stop()
    $script:Connected = $false
    $script:OverlayActive = $false
    $script:AudioSessionActive = $false
    $script:CurrentAudioPath = ''
    foreach ($item in @($script:MediaItems)) { $item.RemoteVisible = $false }
    Reset-MoveStream
    try {
        if (-not $script:TunnelOpen) { Open-AdbTunnel }
        Ensure-TVReceiver
        Send-Request 'POST' '/hide' | Out-Null
        Send-Request 'POST' '/stop-audio' | Out-Null
        $currentAudioLabel.Text = 'Now playing: None'
        if (-not $Quiet) {
            Set-Status 'Broadcast stopped. All layers and audio were removed, and the ADB tunnel was closed.' ([System.Drawing.Color]::FromArgb(55, 125, 80))
        }
    } catch {
        if (-not $Quiet) {
            Set-Status 'The TV is unavailable. Its watchdog will remove the layers within approximately 30 seconds.' ([System.Drawing.Color]::FromArgb(180, 95, 35))
        }
    }
    Close-AdbTunnel
}

function Update-BroadcastUI {
    if ($script:BroadcastEnabled) {
        $broadcastButton.Text = 'Broadcast: On'
        $broadcastButton.BackColor = [System.Drawing.Color]::FromArgb(17, 92, 76)
        $broadcastButton.FlatAppearance.BorderColor = $script:ThemeSuccess
    } else {
        $broadcastButton.Text = 'Broadcast: Off'
        $broadcastButton.BackColor = $script:ThemeSurfaceRaised
        $broadcastButton.FlatAppearance.BorderColor = $script:ThemeBorder
    }
    $broadcastButton.ForeColor = [System.Drawing.Color]::White
}

function Set-BroadcastEnabled([bool]$Enabled) {
    if ($script:BroadcastEnabled -eq $Enabled) { return }
    $script:BroadcastEnabled = $Enabled
    Update-BroadcastUI
    if ($Enabled) {
        if ($script:MediaItems.Count -eq 0) {
            Set-Status 'Broadcasting is enabled. New layers will appear on the TV automatically.' ([System.Drawing.Color]::FromArgb(55, 125, 80))
        } else {
            $sent = 0
            foreach ($item in @($script:MediaItems)) {
                Send-MediaItem $item $true
                if ($item.RemoteVisible) { $sent++ }
            }
            Set-Status "Broadcasting enabled. Sent $sent of $($script:MediaItems.Count) layer(s)." ([System.Drawing.Color]::FromArgb(55, 125, 80))
        }
    } else {
        Hide-And-Disconnect $true
        Set-Status 'Broadcasting disabled. TV layers and audio were removed; the local preview was preserved.' ([System.Drawing.Color]::FromArgb(70, 78, 92))
    }
    Save-Config
}

function Style-Button($Button, [string]$Mode = 'neutral') {
    $Button.FlatStyle = [System.Windows.Forms.FlatStyle]::Flat
    $Button.FlatAppearance.BorderSize = 1
    $Button.FlatAppearance.MouseOverBackColor = [System.Drawing.Color]::FromArgb(27, 42, 62)
    $Button.FlatAppearance.MouseDownBackColor = [System.Drawing.Color]::FromArgb(18, 90, 108)
    $Button.Cursor = [System.Windows.Forms.Cursors]::Hand
    $Button.Font = New-Object System.Drawing.Font('Segoe UI Semibold', 9)
    $Button.ForeColor = $script:ThemeText
    switch ($Mode) {
        'accent' {
            $Button.BackColor = $script:ThemeAccentDark
            $Button.FlatAppearance.BorderColor = $script:ThemeAccent
        }
        'danger' {
            $Button.BackColor = [System.Drawing.Color]::FromArgb(76, 27, 42)
            $Button.FlatAppearance.BorderColor = $script:ThemeDanger
        }
        default {
            $Button.BackColor = $script:ThemeSurfaceRaised
            $Button.FlatAppearance.BorderColor = $script:ThemeBorder
        }
    }
}

function Style-Input($Control) {
    $Control.BackColor = [System.Drawing.Color]::FromArgb(10, 17, 28)
    $Control.ForeColor = $script:ThemeText
    if ($Control -is [System.Windows.Forms.TextBox]) {
        $Control.BorderStyle = [System.Windows.Forms.BorderStyle]::FixedSingle
    }
}

function New-CardPanel([int]$X, [int]$Y, [int]$Width, [int]$Height) {
    $panel = New-Object System.Windows.Forms.Panel
    $panel.Location = New-Object System.Drawing.Point($X, $Y)
    $panel.Size = New-Object System.Drawing.Size($Width, $Height)
    $panel.BackColor = $script:ThemeSurface
    $panel.Add_Paint({
        param($sender, $eventArgs)
        $borderPen = New-Object System.Drawing.Pen($script:ThemeBorder, 1)
        try {
            $eventArgs.Graphics.DrawRectangle($borderPen, 0, 0,
                [Math]::Max(0, $sender.ClientSize.Width - 1),
                [Math]::Max(0, $sender.ClientSize.Height - 1))
        } finally { $borderPen.Dispose() }
    })
    return $panel
}

