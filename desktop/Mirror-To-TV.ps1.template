$heartbeat = New-Object System.Windows.Forms.Timer
$heartbeat.Interval = 10000
$heartbeat.Add_Tick({
    if (-not $script:Connected -or $script:Closing) { return }
    try {
        Send-Request 'POST' '/ping' | Out-Null
    } catch {
        $heartbeat.Stop()
        $positionStreamTimer.Stop()
        $script:Connected = $false
        $script:OverlayActive = $false
        $script:AudioSessionActive = $false
        foreach ($item in @($script:MediaItems)) { $item.RemoteVisible = $false }
        Close-AdbTunnel
        Set-Status 'Connection lost. The TV will stop all layers and audio automatically.' ([System.Drawing.Color]::FromArgb(180, 95, 35))
    }
})

$positionStreamTimer = New-Object System.Windows.Forms.Timer
# The timer only pumps/completes the queue; Get-DesiredMoveIntervalMs applies
# the selected 10-120/s (or V-Sync) limit. A 5 ms pump also delivers a queued
# mouse-up position promptly after an older slow request completes.
$positionStreamTimer.Interval = 5
$positionStreamTimer.Add_Tick({
    if ($script:Connected -and -not $script:Closing) { Pump-MoveStream $script:ForceMovePending }
})

function Update-VSyncUI {
    if ($script:VSyncEnabled) {
        $vSyncButton.Text = 'V-Sync: On'
        $vSyncButton.BackColor = [System.Drawing.Color]::FromArgb(34, 73, 110)
        $vSyncButton.FlatAppearance.BorderColor = $script:ThemeAccent
        $vSyncButton.ForeColor = [System.Drawing.Color]::White
        $updatesPerSecondBox.Enabled = $false
        $vSyncIntervalBox.Enabled = $true
        $vSyncTransitionBox.Enabled = $true
    } else {
        $vSyncButton.Text = 'V-Sync: Off'
        $vSyncButton.BackColor = $script:ThemeSurfaceRaised
        $vSyncButton.FlatAppearance.BorderColor = $script:ThemeBorder
        $vSyncButton.ForeColor = [System.Drawing.Color]::White
        $updatesPerSecondBox.Enabled = $true
        $vSyncIntervalBox.Enabled = $false
        $vSyncTransitionBox.Enabled = $false
    }
}

function Update-DropModeUI {
