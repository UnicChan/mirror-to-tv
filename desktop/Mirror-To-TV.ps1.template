function Play-AudioTrack([string]$Path) {
    if (-not $script:BroadcastEnabled) {
        Set-Status 'Enable broadcasting before starting audio playback.' ([System.Drawing.Color]::FromArgb(180, 95, 35))
        return
    }
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) {
        Set-Status 'The audio file was not found.' ([System.Drawing.Color]::Firebrick)
        return
    }
    $fileInfo = Get-Item -LiteralPath $Path
    if ($fileInfo.Length -gt 150MB) {
        Set-Status 'The audio file is too large. Maximum size: 150 MB.' ([System.Drawing.Color]::Firebrick)
        return
    }
    $extension = [System.IO.Path]::GetExtension($Path).TrimStart('.').ToLowerInvariant()
    if ($extension -notin @('mp3', 'm4a', 'aac', 'ogg', 'wav', 'flac')) {
        Set-Status 'This audio format is not supported.' ([System.Drawing.Color]::Firebrick)
        return
    }

    Set-Status "Sending audio to the TV: $([System.IO.Path]::GetFileName($Path))" ([System.Drawing.Color]::FromArgb(70, 78, 92))
    try {
        Open-AdbTunnel
        Ensure-TVReceiver
        Send-Request 'POST' '/hide' | Out-Null
        Send-Request 'POST' '/stop-audio' | Out-Null
        Configure-TVAudio
        Send-FileRequest "/play-audio?ext=$extension" $Path | Out-Null
        $script:Connected = $true
        $script:AudioSessionActive = $true
        $script:CurrentAudioPath = $Path
        $currentAudioLabel.Text = "Now playing: $([System.IO.Path]::GetFileName($Path))"
        $heartbeat.Start()
        Save-Config
        if ($script:GlobalMuted) {
            Set-Status 'Audio playback started, but global audio is muted.' ([System.Drawing.Color]::FromArgb(180, 95, 35))
        } else {
            Set-Status 'Audio is playing on the TV.' ([System.Drawing.Color]::FromArgb(55, 125, 80))
        }
    } catch {
        if (-not $script:OverlayActive) {
            $script:Connected = $false
            $script:AudioSessionActive = $false
            $heartbeat.Stop()
            Close-AdbTunnel
        }
        Set-Status "Could not start audio playback: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
    }
}

function Stop-AudioTrack {
    try {
        if ($script:Connected) { Send-Request 'POST' '/stop-audio' | Out-Null }
        $script:AudioSessionActive = $false
        $script:CurrentAudioPath = ''
        $currentAudioLabel.Text = 'Now playing: None'
        Set-Status 'Audio playback stopped.' ([System.Drawing.Color]::FromArgb(70, 78, 92))
    } catch {
        Set-Status "Could not stop audio playback: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
    }
}

function Invoke-Ffmpeg([string[]]$Arguments) {
    if ($null -eq $script:FfmpegPath) {
        throw 'FFmpeg was not found. Extract the complete package, including tools\ffmpeg.exe.'
    }
    $output = & $script:FfmpegPath @Arguments 2>&1
    if ($LASTEXITCODE -ne 0) {
        $message = ($output | Select-Object -Last 4 | Out-String).Trim()
        throw "FFmpeg could not process the media. $message"
    }
}

function Get-ChromaProcessedFile($Item) {
    if ($null -eq $Item) { return '' }
    if (-not $Item.ChromaEnabled) { return [string]$Item.Path }
    $source = Get-Item -LiteralPath $Item.Path
    $color = ([string]$Item.ChromaColor).TrimStart('#').ToUpperInvariant()
    if ($color -notmatch '^[0-9A-F]{6}$') { throw 'The chroma-key color is invalid.' }
    $tolerance = [Math]::Max(1, [Math]::Min(100, [int]$Item.ChromaTolerance))
    $softness = [Math]::Max(0, [Math]::Min(100, [int]$Item.ChromaSoftness))
    $signature = "$($source.FullName)|$($source.Length)|$($source.LastWriteTimeUtc.Ticks)|$color|$tolerance|$softness|$($Item.Kind)"
    if ($Item.ProcessedSignature -eq $signature -and
        (Test-Path -LiteralPath $Item.ProcessedPath -PathType Leaf)) {
        return [string]$Item.ProcessedPath
    }

    Clear-ChromaMediaCache $Item
    New-Item -ItemType Directory -Force -Path $script:ChromaCacheDirectory | Out-Null
    $similarityValue = [string]::Format([System.Globalization.CultureInfo]::InvariantCulture,
        '{0:0.00}', $tolerance / 100.0)
    $softnessValue = [string]::Format([System.Globalization.CultureInfo]::InvariantCulture,
        '{0:0.00}', $softness / 100.0)
    $keyFilter = "colorkey=0x${color}:${similarityValue}:${softnessValue}"
    $outputExtension = if ($Item.Kind -eq 'video') { '.mp4' } elseif ($Item.Kind -eq 'gif') { '.gif' } else { '.png' }
    $outputPath = Join-Path $script:ChromaCacheDirectory "$($Item.Id)-$([guid]::NewGuid().ToString('N'))$outputExtension"

    if ($Item.Kind -eq 'video') {
        $filter = "[0:v]scale=960:540:force_original_aspect_ratio=decrease:force_divisible_by=2,format=rgba,$keyFilter,split=2[rgb][mask];[rgb]format=rgb24[rgb24];[mask]alphaextract,format=gray,format=rgb24[mask24];[rgb24][mask24]hstack=inputs=2,format=yuv420p[out]"
        $arguments = @('-hide_banner', '-loglevel', 'error', '-y', '-i', $Item.Path,
            '-filter_complex', $filter, '-map', '[out]', '-map', '0:a?',
            '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '18',
            '-c:a', 'aac', '-b:a', '128k', '-movflags', '+faststart', $outputPath)
    } elseif ($Item.Kind -eq 'gif') {
        $filter = "[0:v]fps=15,scale=960:540:force_original_aspect_ratio=decrease:force_divisible_by=2,format=rgba,$keyFilter,split[keyed][palette];[palette]palettegen=reserve_transparent=1:transparency_color=ffffff[p];[keyed][p]paletteuse=alpha_threshold=16"
        $arguments = @('-hide_banner', '-loglevel', 'error', '-y', '-ignore_loop', '1',
            '-i', $Item.Path, '-filter_complex', $filter, '-loop', '0', $outputPath)
    } else {
        $filter = "format=rgba,$keyFilter"
        $arguments = @('-hide_banner', '-loglevel', 'error', '-y', '-i', $Item.Path,
            '-vf', $filter, '-frames:v', '1', '-c:v', 'png', $outputPath)
    }

    try {
        Invoke-Ffmpeg $arguments
        if (-not (Test-Path -LiteralPath $outputPath -PathType Leaf)) {
            throw 'FFmpeg did not create the processed media file.'
        }
        if ((Get-Item -LiteralPath $outputPath).Length -gt 150MB) {
            throw 'The processed media exceeds the 150 MB transfer limit.'
        }
        $Item.ProcessedPath = $outputPath
        $Item.ProcessedSignature = $signature
        return $outputPath
    } catch {
        Remove-Item -LiteralPath $outputPath -Force -ErrorAction SilentlyContinue
        throw
    }
}

function Get-ScreenColor {
    $bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen
    $snapshot = [System.Drawing.Bitmap]::new($bounds.Width, $bounds.Height)
    $graphics = [System.Drawing.Graphics]::FromImage($snapshot)
    try {
        $graphics.CopyFromScreen($bounds.Left, $bounds.Top, 0, 0, $bounds.Size)
    } finally {
        $graphics.Dispose()
    }

    $picker = New-Object System.Windows.Forms.Form
    $picker.FormBorderStyle = [System.Windows.Forms.FormBorderStyle]::None
    $picker.StartPosition = [System.Windows.Forms.FormStartPosition]::Manual
    $picker.Bounds = $bounds
    $picker.BackgroundImage = $snapshot
    $picker.BackgroundImageLayout = [System.Windows.Forms.ImageLayout]::None
    $picker.Cursor = [System.Windows.Forms.Cursors]::Cross
    $picker.TopMost = $true
    $picker.KeyPreview = $true
    $picker.ShowInTaskbar = $false
    $picker.Add_MouseDown({
        param($sender, $eventArgs)
        $sender.Tag = $snapshot.GetPixel($eventArgs.X, $eventArgs.Y)
        $sender.Close()
    })
    $picker.Add_KeyDown({
        param($sender, $eventArgs)
        if ($eventArgs.KeyCode -eq [System.Windows.Forms.Keys]::Escape) { $sender.Close() }
    })
    try {
        [void]$picker.ShowDialog()
        return $picker.Tag
    } finally {
        $picker.Dispose()
        $snapshot.Dispose()
    }
}

