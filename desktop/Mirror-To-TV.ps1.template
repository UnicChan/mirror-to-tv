Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing
Add-Type -AssemblyName System.Net.Http

[System.Windows.Forms.Application]::EnableVisualStyles()

# Restrained sci-fi palette: deep navy surfaces, cool cyan focus and one warm danger color.
$script:ThemeBackground = [System.Drawing.Color]::FromArgb(8, 12, 20)
$script:ThemeSurface = [System.Drawing.Color]::FromArgb(15, 22, 35)
$script:ThemeSurfaceRaised = [System.Drawing.Color]::FromArgb(20, 30, 47)
$script:ThemeBorder = [System.Drawing.Color]::FromArgb(42, 59, 82)
$script:ThemeText = [System.Drawing.Color]::FromArgb(233, 242, 255)
$script:ThemeMuted = [System.Drawing.Color]::FromArgb(126, 145, 171)
$script:ThemeAccent = [System.Drawing.Color]::FromArgb(62, 211, 238)
$script:ThemeAccentDark = [System.Drawing.Color]::FromArgb(21, 103, 126)
$script:ThemeSuccess = [System.Drawing.Color]::FromArgb(53, 214, 156)
$script:ThemeWarning = [System.Drawing.Color]::FromArgb(245, 173, 72)
$script:ThemeDanger = [System.Drawing.Color]::FromArgb(244, 76, 106)

$script:Token = '__MIRROR_TO_TV_TOKEN__'
