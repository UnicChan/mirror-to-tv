$script:AudioSessionActive = $false
$script:TunnelOpen = $false
$script:Closing = $false
$script:CurrentImage = $null
$script:MediaItems = New-Object System.Collections.ArrayList
$script:SelectedMediaItem = $null
$script:NextMediaId = 1
$script:BroadcastEnabled = $false
$script:ChangingSelection = $false
$script:ImageAspect = 1.0
$script:MediaKind = 'image'
$script:LoadedMediaPath = ''
$script:VideoMuted = $false
$script:GlobalMuted = $false
$script:AudioLibrary = New-Object System.Collections.ArrayList
$script:CurrentAudioPath = ''
$script:PositionDirty = $false
$script:DropModeEnabled = $false
$script:VSyncEnabled = $false
$script:VSyncIntervalMs = 500
$script:VSyncTransitionMs = 500
$script:VideoPaused = $false
$script:MoveFailures = 0
$script:PositionRevision = 0L
$script:MoveSentRevision = 0L
$script:MoveTask = $null
$script:MoveRequest = $null
$script:MoveNextAllowedAt = 0L
$script:ForceMovePending = $false
$script:MoveRequestsStarted = 0
$script:MoveRequestsSucceeded = 0
