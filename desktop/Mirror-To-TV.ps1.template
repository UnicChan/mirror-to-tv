$mediaControlButton.Add_Click({
    if (-not $script:Connected -or -not $script:OverlayActive -or $script:MediaKind -ne 'video' -or
        $null -eq $script:SelectedMediaItem -or -not $script:SelectedMediaItem.RemoteVisible) {
        Set-Status 'Video controls are available after a video layer starts playing.' ([System.Drawing.Color]::FromArgb(70, 78, 92))
        return
    }
    try {
        if ($script:VideoPaused) {
            Send-Request 'POST' "/play?id=$($script:SelectedMediaItem.Id)" | Out-Null
            $script:VideoPaused = $false
            Sync-SelectedMediaItem
            Set-Status 'Video playback resumed.' ([System.Drawing.Color]::FromArgb(55, 125, 80))
        } else {
            Send-Request 'POST' "/pause?id=$($script:SelectedMediaItem.Id)" | Out-Null
            $script:VideoPaused = $true
            Sync-SelectedMediaItem
            Set-Status 'Video playback paused. Broadcasting remains active.' ([System.Drawing.Color]::FromArgb(70, 78, 92))
        }
    } catch {
        Set-Status "Could not control video playback: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
    }
})

$broadcastButton.Add_Click({ Set-BroadcastEnabled (-not $script:BroadcastEnabled) })

$form.Add_Shown({
    if ($env:MIRROR_TO_TV_SELFTEST -ne '1' -and $env:MIRROR_TO_TV_CONNECTION_TEST -ne '1' -and
        (Test-Path -LiteralPath $script:ConfigPath)) {
        try {
            $saved = Get-Content -Raw -LiteralPath $script:ConfigPath | ConvertFrom-Json
            if ($saved.tvIp) { $ipBox.Text = [string]$saved.tvIp }
            if ($saved.adbPort) { $adbPortBox.Value = [decimal]$saved.adbPort }
            if ($saved.size) { $script:OverlaySize = [Math]::Max(1, [Math]::Min(100, [int]$saved.size)) }
            if ($null -ne $saved.opacity) { $opacitySlider.Value = [int]$saved.opacity }
            if ($null -ne $saved.x) { $script:OverlayX = [double]$saved.x }
            if ($null -ne $saved.y) { $script:OverlayY = [double]$saved.y }
            if ($null -ne $saved.dropModeEnabled) { $script:DropModeEnabled = [bool]$saved.dropModeEnabled }
            if ($null -ne $saved.updatesPerSecond) {
                $savedRate = [Math]::Max($updatesPerSecondBox.Minimum,
                    [Math]::Min($updatesPerSecondBox.Maximum, [int]$saved.updatesPerSecond))
                $updatesPerSecondBox.Value = $savedRate
            }
            if ($null -ne $saved.vSyncEnabled) { $script:VSyncEnabled = [bool]$saved.vSyncEnabled }
            if ($null -ne $saved.vSyncIntervalMs) {
                $script:VSyncIntervalMs = [Math]::Max([int]$vSyncIntervalBox.Minimum,
                    [Math]::Min([int]$vSyncIntervalBox.Maximum, [int]$saved.vSyncIntervalMs))
                $vSyncIntervalBox.Value = $script:VSyncIntervalMs
            }
            if ($null -ne $saved.vSyncTransitionMs) {
                $script:VSyncTransitionMs = [Math]::Max([int]$vSyncTransitionBox.Minimum,
                    [Math]::Min([int]$vSyncTransitionBox.Maximum, [int]$saved.vSyncTransitionMs))
                $vSyncTransitionBox.Value = $script:VSyncTransitionMs
            }
            if ($null -ne $saved.globalMuted) { $script:GlobalMuted = [bool]$saved.globalMuted }
            if ($null -ne $saved.videoMuted) { $script:VideoMuted = [bool]$saved.videoMuted }
            if ($null -ne $saved.audioLibrary) {
                $script:AudioLibrary.Clear()
                foreach ($savedAudio in @($saved.audioLibrary)) {
                    $savedAudioPath = [string]$savedAudio
                    $alreadyPresent = @($script:AudioLibrary) -contains $savedAudioPath
                    if ((-not [string]::IsNullOrWhiteSpace($savedAudioPath)) -and (-not $alreadyPresent)) {
                        [void]$script:AudioLibrary.Add($savedAudioPath)
                    }
                }
            }
            if ($saved.lastImage -and (Test-Path -LiteralPath ([string]$saved.lastImage) -PathType Leaf)) {
                $fileBox.Text = [string]$saved.lastImage
                Load-SelectedMedia $fileBox.Text $false
            }
        } catch { }
    }
    Update-DropModeUI
    Update-VSyncUI
    Update-GlobalMuteUI
    Refresh-AudioLibraryUI
    Clamp-OverlayPosition
    $screenPreview.Invalidate()
    $browseButton.Focus()
})

$form.Add_FormClosing({
    $script:Closing = $true
    Save-Config
    if ($script:Connected) { Hide-And-Disconnect $true }
    else { Close-AdbTunnel }
    $heartbeat.Stop()
    $heartbeat.Dispose()
    $positionStreamTimer.Stop()
    $positionStreamTimer.Dispose()
    Reset-MoveStream
    $moveHttp.Dispose()
    $http.Dispose()
    foreach ($item in @($script:MediaItems)) {
        if ($null -ne $item.Image) { $item.Image.Dispose() }
        Clear-ChromaMediaCache $item
    }
})

if ($env:MIRROR_TO_TV_CONNECTION_TEST -eq '1') {
    [void]$form.CreateControl()
    [void]$screenPreview.CreateControl()
    $script:BroadcastEnabled = $true
    Update-BroadcastUI
    try {
        if ($env:MIRROR_TO_TV_VSYNC_TEST -eq '1') {
            $script:VSyncEnabled = $true
            $script:VSyncIntervalMs = 500
            $script:VSyncTransitionMs = 250
            $vSyncIntervalBox.Value = 500
            $vSyncTransitionBox.Value = 250
            Update-VSyncUI
        }
        Open-AdbTunnel
        Ensure-TVReceiver
        if ($env:MIRROR_TO_TV_AUDIO_TEST -and (Test-Path -LiteralPath $env:MIRROR_TO_TV_AUDIO_TEST -PathType Leaf)) {
            [void]$script:AudioLibrary.Add($env:MIRROR_TO_TV_AUDIO_TEST)
            Refresh-AudioLibraryUI
            $audioTestRow = $audioLibraryFlow.Controls[0]
            $audioTestPlay = $audioTestRow.Controls | Where-Object {
                $_ -is [System.Windows.Forms.Button] -and $_.Text -eq '▶'
            } | Select-Object -First 1
            if ($null -eq $audioTestPlay) { throw 'AUDIO_TEST_PLAY_BUTTON_MISSING' }
            Play-AudioTrack $env:MIRROR_TO_TV_AUDIO_TEST
            Start-Sleep -Milliseconds 300
            $audioPlayingStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
            if (-not $script:AudioSessionActive -or -not $audioPlayingStatus.audioPlaying) {
                throw "AUDIO_TEST_PLAY_FAILED connected=$script:Connected session=$script:AudioSessionActive tv=$($audioPlayingStatus.audioPlaying) status=$($statusLabel.Text)"
            }
            if ($script:GlobalMuted) { Toggle-GlobalMute }
            Toggle-GlobalMute
            $audioMutedStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
            if (-not $audioMutedStatus.globalMuted -or -not $audioMutedStatus.audioPlaying) {
                throw 'AUDIO_TEST_GLOBAL_MUTE_FAILED'
            }
            Toggle-GlobalMute
            if (-not $env:MIRROR_TO_TV_MEDIA_TEST) {
                Stop-AudioTrack
                $audioStoppedStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
                if ($audioStoppedStatus.audioActive) { throw 'AUDIO_TEST_STOP_FAILED' }
            }
            $script:AudioLibrary.Clear()
            Refresh-AudioLibraryUI
            $audioStopResult = if ($env:MIRROR_TO_TV_MEDIA_TEST) { 'deferred' } else { 'true' }
            Write-Output "AUDIO_DESKTOP_TEST_OK library=1 play=true globalMute=true stop=$audioStopResult"
        }
        if ($env:MIRROR_TO_TV_MEDIA_TEST -and (Test-Path -LiteralPath $env:MIRROR_TO_TV_MEDIA_TEST -PathType Leaf)) {
            $fileBox.Text = $env:MIRROR_TO_TV_MEDIA_TEST
            Load-SelectedMedia $env:MIRROR_TO_TV_MEDIA_TEST
            if ($env:MIRROR_TO_TV_VIDEO_MUTED_TEST -eq '1') { $script:VideoMuted = $true }
            Send-CurrentMedia $false
            if (-not $script:Connected) { throw 'MEDIA_TEST_SHOW_FAILED' }
            $primaryTestItem = $script:SelectedMediaItem
            if ($env:MIRROR_TO_TV_MEDIA_TEST_2 -and (Test-Path -LiteralPath $env:MIRROR_TO_TV_MEDIA_TEST_2 -PathType Leaf)) {
                $secondTestItem = Add-MediaItem $env:MIRROR_TO_TV_MEDIA_TEST_2 $true
                $multiStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
                if ($multiStatus.mediaCount -ne 2 -or -not $secondTestItem.RemoteVisible) {
                    throw "MULTI_MEDIA_TRANSMIT_FAILED count=$($multiStatus.mediaCount) remote=$($secondTestItem.RemoteVisible)"
                }
                Remove-MediaItem $secondTestItem
                $afterRemoveStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
                if ($afterRemoveStatus.mediaCount -ne 1) { throw "MULTI_MEDIA_REMOTE_REMOVE_FAILED count=$($afterRemoveStatus.mediaCount)" }
                Select-MediaItem $primaryTestItem
                Write-Output 'MULTI_MEDIA_CONNECTION_TEST_OK add=2 remove-one=ok'
            }
            if ($env:MIRROR_TO_TV_VIDEO_MUTED_TEST -eq '1') {
                $combinedAudioStatus = (Send-Request 'GET' '/status') | ConvertFrom-Json
                if (-not $combinedAudioStatus.videoMuted -or -not $combinedAudioStatus.audioPlaying) {
                    throw "COMBINED_AUDIO_VIDEO_FAILED videoMuted=$($combinedAudioStatus.videoMuted) audioPlaying=$($combinedAudioStatus.audioPlaying)"
                }
                Write-Output 'COMBINED_AUDIO_VIDEO_OK videoMuted=true libraryAudio=true'
            }
            Notify-MotionStart
            $script:OverlayX = 0.12
            $script:OverlayY = 0.18
            $script:PositionDirty = $true
            Send-MoveUpdate $false
            if ($script:PositionDirty) { throw 'MEDIA_TEST_MOVE_FAILED' }
            if ($script:VSyncEnabled) { Start-Sleep -Milliseconds 120 }

            if ($env:MIRROR_TO_TV_STREAM_TEST -eq '1') {
                Write-Output 'STREAM_STAGE begin'
                function Wait-TestMoveIdle([int]$TimeoutMs) {
                    $deadline = (Get-MonotonicMilliseconds) + $TimeoutMs
                    while ((Get-MonotonicMilliseconds) -lt $deadline) {
                        Pump-MoveStream $script:ForceMovePending
                        [System.Windows.Forms.Application]::DoEvents()
                        if ($null -eq $script:MoveTask -and -not $script:PositionDirty) { return }
                        Start-Sleep -Milliseconds 10
                    }
                    throw 'MOVE_QUEUE_TIMEOUT'
                }

                $script:DropModeEnabled = $false
                $script:VSyncEnabled = $false
                $updatesPerSecondBox.Value = 30
                Configure-TVVSync
                Write-Output 'STREAM_STAGE normal'
                $normalStarted = $script:MoveRequestsStarted
                $script:MoveRequestTimes = @()
                $normalDeadline = (Get-MonotonicMilliseconds) + 650
                $normalStep = 0
                while ((Get-MonotonicMilliseconds) -lt $normalDeadline) {
                    $normalStep++
                    $script:OverlayX = 0.10 + (($normalStep % 40) / 100.0)
                    Mark-PositionDirty
                    Pump-MoveStream $false
                    [System.Windows.Forms.Application]::DoEvents()
                    Start-Sleep -Milliseconds 10
                }
                $script:OverlayX = 0.63
                Mark-PositionDirty
                Queue-FinalMove
                Wait-TestMoveIdle 5000
                $normalCount = $script:MoveRequestsStarted - $normalStarted
                if ($normalCount -lt 8 -or $normalCount -gt 25) {
                    throw "NORMAL_RATE_FAILED count=$normalCount successes=$script:MoveRequestsSucceeded failures=$script:MoveFailures times=$($script:MoveRequestTimes -join ',')"
                }

                $script:DropModeEnabled = $true
                Write-Output "STREAM_STAGE drop normal=$normalCount"
                $dropStarted = $script:MoveRequestsStarted
                foreach ($dropX in 0.20, 0.30, 0.40, 0.50) {
                    $script:OverlayX = $dropX
                    Mark-PositionDirty
                    Pump-MoveStream $false
                    [System.Windows.Forms.Application]::DoEvents()
                    Start-Sleep -Milliseconds 40
                }
                if ($script:MoveRequestsStarted -ne $dropStarted) { throw 'DROP_SENT_BEFORE_RELEASE' }
                Queue-FinalMove
                Wait-TestMoveIdle 5000
                $dropCount = $script:MoveRequestsStarted - $dropStarted
                if ($dropCount -ne 1) { throw "DROP_FINAL_COUNT_FAILED count=$dropCount" }

                $script:DropModeEnabled = $false
                Write-Output "STREAM_STAGE vsync drop=$dropCount"
                $script:VSyncEnabled = $true
                $script:VSyncIntervalMs = 500
                $script:VSyncTransitionMs = 250
                Configure-TVVSync
                $vSyncConfiguration = (Send-Request 'GET' '/status') | ConvertFrom-Json
                if (-not $vSyncConfiguration.vSync -or $vSyncConfiguration.vSyncIntervalMs -ne 500 -or
                    $vSyncConfiguration.vSyncTransitionMs -ne 250) {
                    throw "VSYNC_CONFIGURATION_FAILED interval=$($vSyncConfiguration.vSyncIntervalMs) transition=$($vSyncConfiguration.vSyncTransitionMs)"
                }
                $vSyncStarted = $script:MoveRequestsStarted
                $vSyncDeadline = (Get-MonotonicMilliseconds) + 1150
                $vSyncStep = 0
                while ((Get-MonotonicMilliseconds) -lt $vSyncDeadline) {
                    $vSyncStep++
                    $script:OverlayX = 0.20 + (($vSyncStep % 30) / 100.0)
                    Mark-PositionDirty
                    Pump-MoveStream $false
                    [System.Windows.Forms.Application]::DoEvents()
                    Start-Sleep -Milliseconds 20
                }
                $script:OverlayX = 0.71
                Mark-PositionDirty
                Queue-FinalMove
                Wait-TestMoveIdle 5000
                $vSyncCount = $script:MoveRequestsStarted - $vSyncStarted
                if ($vSyncCount -lt 2 -or $vSyncCount -gt 5) { throw "VSYNC_RATE_FAILED count=$vSyncCount" }
                Write-Output "STREAM_TEST_OK normal=$normalCount drop=$dropCount vsync=$vSyncCount successes=$script:MoveRequestsSucceeded"
                Start-Sleep -Milliseconds 650
            }
        }
        $connectionStatus = Send-Request 'GET' '/status'
        if ($env:MIRROR_TO_TV_STREAM_TEST -eq '1') {
            $parsedStatus = $connectionStatus | ConvertFrom-Json
            if ([Math]::Abs([int]$parsedStatus.x - 710) -gt 2) {
                throw "STREAM_FINAL_POSITION_FAILED x=$($parsedStatus.x)"
            }
        }
        Write-Output "CONNECTION_TEST_OK $connectionStatus"
        if ($script:Connected) {
            Send-Request 'POST' '/hide' | Out-Null
            Send-Request 'POST' '/stop-audio' | Out-Null
            $script:Connected = $false
            $script:OverlayActive = $false
            $script:AudioSessionActive = $false
        }
    } finally {
        Close-AdbTunnel
        $heartbeat.Dispose()
        $positionStreamTimer.Dispose()
        Reset-MoveStream
        $moveHttp.Dispose()
        $http.Dispose()
        $form.Dispose()
    }
    return
}

if ($env:MIRROR_TO_TV_SELFTEST -eq '1') {
    [void]$form.CreateControl()
    [void]$screenPreview.CreateControl()
    $selfTestImagePath = $env:MIRROR_TO_TV_TEST_IMAGE
    if ([string]::IsNullOrWhiteSpace($selfTestImagePath) -or
        -not (Test-Path -LiteralPath $selfTestImagePath -PathType Leaf)) {
        $selfTestImagePath = Join-Path $PSScriptRoot 'mirror-to-tv-icon.png'
        if (-not (Test-Path -LiteralPath $selfTestImagePath -PathType Leaf)) {
            $selfTestImagePath = $null
        }
    }
    if ([string]::IsNullOrWhiteSpace($selfTestImagePath)) { throw 'SELFTEST_IMAGE_NOT_FOUND' }
    $fileBox.Text = $selfTestImagePath
    Load-SelectedMedia $selfTestImagePath
    if ($env:MIRROR_TO_TV_CHROMA_TEST -eq '1') {
        $script:SelectedMediaItem.ChromaEnabled = $true
        if ($env:MIRROR_TO_TV_CHROMA_COLOR -match '^[0-9a-fA-F]{6}$') {
            $script:SelectedMediaItem.ChromaColor = $env:MIRROR_TO_TV_CHROMA_COLOR.ToUpperInvariant()
        }
        $processedTestPath = Get-ChromaProcessedFile $script:SelectedMediaItem
        if (-not (Test-Path -LiteralPath $processedTestPath -PathType Leaf)) {
            throw 'CHROMA_PROCESSING_FAILED'
        }
        $expectedExtension = if ($script:MediaKind -eq 'video') { '.mp4' } elseif ($script:MediaKind -eq 'gif') { '.gif' } else { '.png' }
        if ([System.IO.Path]::GetExtension($processedTestPath) -ne $expectedExtension) {
            throw "CHROMA_EXTENSION_FAILED expected=$expectedExtension actual=$([System.IO.Path]::GetExtension($processedTestPath))"
        }
        Write-Output "CHROMA_PROCESSING_OK kind=$($script:MediaKind) bytes=$((Get-Item -LiteralPath $processedTestPath).Length)"
        Clear-ChromaMediaCache $script:SelectedMediaItem
        $script:SelectedMediaItem.ChromaEnabled = $false
    }
    Clamp-OverlayPosition
    $testRectangle = Get-OverlayRectangle
    $dragResult = 'not-run'
    $resizeResult = 'not-run'
    if ($null -ne $script:CurrentImage) {
        $script:OverlayX = 0.40
        $script:OverlayY = 0.30
        Clamp-OverlayPosition
        $dragRectangle = Get-OverlayRectangle
        $dragStartX = $dragRectangle.X + ($dragRectangle.Width / 2.0)
        $dragStartY = $dragRectangle.Y + ($dragRectangle.Height / 2.0)
        $beforeDragX = $script:OverlayX
        $beforeDragY = $script:OverlayY
        if (-not (Start-PreviewDrag $dragStartX $dragStartY)) { throw 'DRAG_START_FAILED' }
        if (-not (Update-PreviewDrag ($dragStartX - 40) ($dragStartY + 30))) { throw 'DRAG_MOVE_FAILED' }
        $script:Dragging = $false
        if ([Math]::Abs($script:OverlayX - ($beforeDragX - (40.0 / 640.0))) -gt 0.002) { throw 'DRAG_X_FAILED' }
        if ([Math]::Abs($script:OverlayY - ($beforeDragY + (30.0 / 360.0))) -gt 0.002) { throw 'DRAG_Y_FAILED' }
        $dragResult = 'ok'

        $script:OverlaySize = 25
        $script:OverlayX = 0.30
        $script:OverlayY = 0.20
        Clamp-OverlayPosition
        $resizeRectangle = Get-OverlayRectangle
        $resizeHandle = Get-ResizeHandle $resizeRectangle.Right $resizeRectangle.Bottom
        if ($resizeHandle -ne 'bottom-right') { throw 'RESIZE_HANDLE_FAILED' }
        $beforeResize = $script:OverlaySize
        if (-not (Start-PreviewResize $resizeHandle)) { throw 'RESIZE_START_FAILED' }
        if (-not (Update-PreviewResize ($resizeRectangle.Right + 70) ($resizeRectangle.Bottom + (70 / $script:ImageAspect)))) {
            throw 'RESIZE_MOVE_FAILED'
        }
        $script:Resizing = $false
        $script:ResizeCorner = ''
        if ($script:OverlaySize -le $beforeResize) { throw 'RESIZE_GROW_FAILED' }
        $resizeResult = 'ok'
    }

    $opacitySlider.Value = 0
    if ($opacitySlider.Value -ne 0) { throw 'OPACITY_ZERO_FAILED' }
    if ($opacitySlider.Orientation -ne [System.Windows.Forms.Orientation]::Vertical -or
        -not $opacityPanel.Controls.Contains($eyeIcon)) { throw 'VERTICAL_OPACITY_UI_FAILED' }
    if ($null -ne (Get-Variable -Name hint -Scope Script -ErrorAction SilentlyContinue)) {
        throw 'VSYNC_HINT_STILL_VISIBLE'
    }
    $script:OverlaySize = 100
    if ($script:OverlaySize -ne 100) { throw 'SIZE_MAX_FAILED' }
    $updatesPerSecondBox.Value = 120
    if ([Math]::Abs((Get-DesiredMoveIntervalMs) - (1000.0 / 120.0)) -gt 0.001) { throw 'RATE_MAX_FAILED' }
    $updatesPerSecondBox.Value = 10
    if ((Get-DesiredMoveIntervalMs) -ne 100) { throw 'RATE_MIN_FAILED' }
    if ($script:DropModeEnabled) { throw 'DROP_DEFAULT_FAILED' }
    $script:DropModeEnabled = $true
    Update-DropModeUI
    if ($dropModeButton.Text -ne 'Drop mode: On') { throw 'DROP_UI_ON_FAILED' }
    $script:DropModeEnabled = $false
    Update-DropModeUI
    $script:VSyncEnabled = $true
    $script:VSyncIntervalMs = 375
    $script:VSyncTransitionMs = 225
    $vSyncIntervalBox.Value = 375
    $vSyncTransitionBox.Value = 225
    Update-VSyncUI
    if ((Get-DesiredMoveIntervalMs) -ne 375 -or $updatesPerSecondBox.Enabled -or
        -not $vSyncTransitionBox.Enabled -or $script:VSyncTransitionMs -ne 225) {
        throw 'VSYNC_CUSTOM_FAILED'
    }
    $script:VSyncIntervalMs = 1735
    $vSyncIntervalBox.Value = 1735
    Update-VSyncUI
    if ((Get-DesiredMoveIntervalMs) -ne 1735) { throw 'VSYNC_CUSTOM_2_FAILED' }
    $script:VSyncEnabled = $false
    Update-VSyncUI
    if (-not $updatesPerSecondBox.Enabled -or (Get-DesiredMoveIntervalMs) -ne 100) { throw 'VSYNC_OFF_FAILED' }

    if ($script:GlobalMuted) { throw 'GLOBAL_MUTE_DEFAULT_FAILED' }
    Toggle-GlobalMute $true
    if (-not $script:GlobalMuted -or $globalMuteButton.Text -ne 'Global audio: Muted') { throw 'GLOBAL_MUTE_ON_FAILED' }
    Toggle-GlobalMute $true
    if ($script:GlobalMuted -or $globalMuteButton.Text -ne 'Global audio: On') { throw 'GLOBAL_MUTE_OFF_FAILED' }

    if ($script:BroadcastEnabled -or $broadcastButton.Text -ne 'Broadcast: Off') { throw 'BROADCAST_DEFAULT_FAILED' }
    $savedMediaKind = $script:MediaKind
    $savedItemKind = $script:SelectedMediaItem.Kind
    $script:SelectedMediaItem.Kind = 'video'
    $script:MediaKind = 'video'
    $videoMuteRectangle = Get-VideoMuteRectangle
    if ($videoMuteRectangle.IsEmpty) { throw 'VIDEO_MUTE_RECT_FAILED' }
    $videoMuteCursor = Get-PreviewCursor ($videoMuteRectangle.X + 2) ($videoMuteRectangle.Y + 2)
    if ($videoMuteCursor -ne [System.Windows.Forms.Cursors]::Hand) { throw 'VIDEO_MUTE_HIT_FAILED' }
    $script:VideoMuted = $false
    Toggle-VideoMute
    if (-not $script:VideoMuted) { throw 'VIDEO_MUTE_ON_FAILED' }
    Toggle-VideoMute
    if ($script:VideoMuted) { throw 'VIDEO_MUTE_OFF_FAILED' }
    $script:SelectedMediaItem.Kind = $savedItemKind
    $script:MediaKind = $savedMediaKind

    $secondItem = Add-MediaItem $selfTestImagePath $false
    $thirdItem = Add-MediaItem $selfTestImagePath $false
    if ($script:MediaItems.Count -ne 3 -or $secondItem.Id -eq $thirdItem.Id) { throw 'MULTI_MEDIA_ADD_FAILED' }
    Select-MediaItem $null
    $thirdItem.Size = 25
    $thirdItem.X = 0.25
    $thirdItem.Y = 0.25
    $thirdRectangle = Get-MediaItemRectangle $thirdItem
    $deleteRectangle = Get-DeleteRectangle $thirdItem
    if ($deleteRectangle.IsEmpty -or $deleteRectangle.Width -gt 22.1 -or $deleteRectangle.X -le $thirdRectangle.Right) {
        throw 'MULTI_MEDIA_DELETE_BUTTON_FAILED'
    }
    Remove-MediaItem $thirdItem
    if ($script:MediaItems.Count -ne 2) { throw 'MULTI_MEDIA_REMOVE_FAILED' }
    Select-MediaItem $secondItem

    [void]$script:AudioLibrary.Add('C:\test-audio.mp3')
    Refresh-AudioLibraryUI
    if ($audioLibraryFlow.Controls.Count -ne 1) { throw 'AUDIO_LIBRARY_ROW_FAILED' }
    $libraryRow = $audioLibraryFlow.Controls[0]
    $playControl = $libraryRow.Controls | Where-Object { $_ -is [System.Windows.Forms.Button] -and $_.Text -eq '▶' } | Select-Object -First 1
    if ($null -eq $playControl) { throw 'AUDIO_LIBRARY_PLAY_FAILED' }
    $script:AudioLibrary.Clear()
    Refresh-AudioLibraryUI
    Select-MediaItem $null
    $script:MediaItems[0].Kind = 'image'
    $script:MediaItems[0].Size = 34
    $script:MediaItems[0].Opacity = 100
    $script:MediaItems[0].X = 0.08
    $script:MediaItems[0].Y = 0.12
    $secondItem.Kind = 'image'
    $secondItem.Size = 29
    $secondItem.Opacity = 100
    $secondItem.X = 0.56
    $secondItem.Y = 0.47
    Select-MediaItem $secondItem
    $previewRender = [System.Drawing.Bitmap]::new($screenPreview.Width, $screenPreview.Height)
    try {
        $previewBounds = [System.Drawing.Rectangle]::new(0, 0, $screenPreview.Width, $screenPreview.Height)
        $screenPreview.DrawToBitmap($previewRender, $previewBounds)
    } finally { $previewRender.Dispose() }
    if ($script:LastPaintError) { throw "PAINT_SELFTEST_FAILED: $script:LastPaintError" }
    if ($env:MIRROR_TO_TV_RENDER_PATH) {
        $form.Show()
        [System.Windows.Forms.Application]::DoEvents()
        $render = [System.Drawing.Bitmap]::new($form.Width, $form.Height)
        try {
            $renderBounds = [System.Drawing.Rectangle]::new(0, 0, $form.Width, $form.Height)
            $form.DrawToBitmap($render, $renderBounds)
            $render.Save($env:MIRROR_TO_TV_RENDER_PATH, [System.Drawing.Imaging.ImageFormat]::Png)
        } finally {
            $render.Dispose()
            $form.Hide()
        }
    }
    Write-Output "SELFTEST_OK controls=$($form.Controls.Count) preview=$([Math]::Round($testRectangle.Width))x$([Math]::Round($testRectangle.Height)) drag=$dragResult resize=$resizeResult design=sci-fi-dark size-state=scalar opacity=vertical-eye multi-media=2 delete=outside-small broadcast=off-default rate=10-120 opacity-range=0-100 drop=off-default vsync=50-10000ms-custom transition=50-5000ms-custom audio-library=ok global-mute=ok video-mute=ok adb=$script:AdbPath"
    $heartbeat.Dispose()
    $positionStreamTimer.Dispose()
    $moveHttp.Dispose()
    $http.Dispose()
    $form.Dispose()
    return
}

[void]$form.ShowDialog()
$form.Dispose()
