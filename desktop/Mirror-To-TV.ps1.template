$http = New-Object System.Net.Http.HttpClient
$http.Timeout = [TimeSpan]::FromMinutes(10)
$http.DefaultRequestHeaders.ExpectContinue = $false
$http.DefaultRequestHeaders.Add('X-Overlay-Token', $script:Token)

# Position updates use their own short-timeout client. They are sent asynchronously,
# so a slow Wi-Fi packet can never freeze mouse dragging in the WinForms UI.
$moveHttp = New-Object System.Net.Http.HttpClient
$moveHttp.Timeout = [TimeSpan]::FromSeconds(3)
$moveHttp.DefaultRequestHeaders.ExpectContinue = $false
$moveHttp.DefaultRequestHeaders.Add('X-Overlay-Token', $script:Token)

function Find-Adb {
    $candidates = New-Object System.Collections.Generic.List[string]
    $candidates.Add((Join-Path $PSScriptRoot 'tools\adb.exe'))
    foreach ($sdkRoot in @($env:ANDROID_HOME, $env:ANDROID_SDK_ROOT)) {
        if (-not [string]::IsNullOrWhiteSpace($sdkRoot)) {
            $candidates.Add((Join-Path $sdkRoot 'platform-tools\adb.exe'))
        }
    }
    if (-not [string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) {
        $candidates.Add((Join-Path $env:LOCALAPPDATA 'Android\Sdk\platform-tools\adb.exe'))
    }
    foreach ($candidate in $candidates) {
        if (Test-Path -LiteralPath $candidate -PathType Leaf) { return $candidate }
    }
    $command = Get-Command adb.exe -ErrorAction SilentlyContinue
    if ($null -ne $command) { return $command.Source }
    return $null
}

$script:AdbPath = Find-Adb

function Find-Ffmpeg {
    $bundled = Join-Path $PSScriptRoot 'tools\ffmpeg.exe'
    if (Test-Path -LiteralPath $bundled -PathType Leaf) { return $bundled }
    $command = Get-Command ffmpeg.exe -ErrorAction SilentlyContinue
    if ($null -ne $command) { return $command.Source }
    return $null
}

$script:FfmpegPath = Find-Ffmpeg

function New-Label([string]$Text, [int]$X, [int]$Y, [int]$Width, [int]$Height = 24) {
    $label = New-Object System.Windows.Forms.Label
    $label.Text = $Text
    $label.Location = New-Object System.Drawing.Point($X, $Y)
    $label.Size = New-Object System.Drawing.Size($Width, $Height)
    $label.Font = New-Object System.Drawing.Font('Segoe UI', 10)
    $label.ForeColor = $script:ThemeText
    $label.BackColor = [System.Drawing.Color]::Transparent
    return $label
}

function Set-Status([string]$Text, [System.Drawing.Color]$Color) {
    $statusLabel.Text = $Text
    if ($Color -eq [System.Drawing.Color]::Firebrick) {
        $statusColor = $script:ThemeDanger
    } elseif ($Color.R -gt 130 -and $Color.G -lt 135) {
        $statusColor = $script:ThemeWarning
    } elseif ($Color.G -gt $Color.R) {
        $statusColor = $script:ThemeSuccess
    } else {
        $statusColor = $script:ThemeMuted
    }
    $statusLabel.ForeColor = $statusColor
    if ($null -ne $statusSignal) { $statusSignal.BackColor = $statusColor }
    $statusLabel.Refresh()
    if ($null -ne $statusSignal) { $statusSignal.Refresh() }
}

function Get-TVSerial {
    $address = $ipBox.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($address)) { throw 'Enter the TV IP address.' }
    return "${address}:$([int]$adbPortBox.Value)"
}

function Open-AdbTunnel {
    if ($null -eq $script:AdbPath) {
        throw 'adb.exe was not found. Extract the complete package, including the tools folder.'
    }
    if ($script:TunnelOpen) { return }
    $serial = Get-TVSerial
    $connectOutput = & $script:AdbPath connect $serial 2>&1
    if ($LASTEXITCODE -ne 0) { throw "ADB connection failed: $connectOutput" }
    $state = (& $script:AdbPath -s $serial get-state 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0 -or $state -ne 'device') {
        throw 'The TV rejected the ADB connection. Check the address and network debugging settings.'
    }
    $forwardOutput = & $script:AdbPath -s $serial forward "tcp:$script:LocalTunnelPort" "tcp:$script:ReceiverPort" 2>&1
    if ($LASTEXITCODE -ne 0) { throw "Could not open the ADB tunnel: $forwardOutput" }
    $script:TunnelOpen = $true
}

function Close-AdbTunnel {
    if ($null -eq $script:AdbPath) { return }
    try {
        $serial = Get-TVSerial
        & $script:AdbPath -s $serial forward --remove "tcp:$script:LocalTunnelPort" 2>&1 | Out-Null
        & $script:AdbPath disconnect $serial 2>&1 | Out-Null
    } catch { }
    $script:TunnelOpen = $false
}

function Send-Request([string]$Method, [string]$Path, [byte[]]$Body = $null) {
    $url = "http://127.0.0.1:$script:LocalTunnelPort$Path"
    $content = $null
    $response = $null
    try {
        if ($null -ne $Body) {
            $content = New-Object System.Net.Http.ByteArrayContent -ArgumentList (,$Body)
            $content.Headers.ContentType = New-Object System.Net.Http.Headers.MediaTypeHeaderValue('application/octet-stream')
        }
        if ($Method -eq 'GET') {
            $response = $http.GetAsync($url).GetAwaiter().GetResult()
        } else {
            if ($null -eq $content) {
                $content = New-Object System.Net.Http.ByteArrayContent -ArgumentList (,[byte[]]@())
            }
            $response = $http.PostAsync($url, $content).GetAwaiter().GetResult()
        }
        $text = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
        if (-not $response.IsSuccessStatusCode) {
            if ($text -match 'overlay_permission_required') {
                throw 'Overlay permission has not been granted on the TV.'
            }
            throw "The TV returned error $([int]$response.StatusCode): $text"
        }
        return $text
    } finally {
        if ($null -ne $response) { $response.Dispose() }
        if ($null -ne $content) { $content.Dispose() }
    }
}

function Send-FileRequest([string]$Path, [string]$FilePath) {
    $url = "http://127.0.0.1:$script:LocalTunnelPort$Path"
    $stream = $null
    $content = $null
    $response = $null
    try {
        $stream = [System.IO.File]::Open($FilePath, [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Read, [System.IO.FileShare]::Read)
        $content = New-Object System.Net.Http.StreamContent -ArgumentList $stream
        $content.Headers.ContentLength = $stream.Length
        $content.Headers.ContentType = New-Object System.Net.Http.Headers.MediaTypeHeaderValue('application/octet-stream')
        $response = $http.PostAsync($url, $content).GetAwaiter().GetResult()
        $text = $response.Content.ReadAsStringAsync().GetAwaiter().GetResult()
        if (-not $response.IsSuccessStatusCode) {
            if ($text -match 'overlay_permission_required') {
                throw 'Overlay permission has not been granted on the TV.'
            }
            if ($text -match 'gif_decode_failed') {
                throw 'The TV could not decode this GIF.'
            }
            throw "The TV returned error $([int]$response.StatusCode): $text"
        }
        return $text
    } finally {
        if ($null -ne $response) { $response.Dispose() }
        if ($null -ne $content) { $content.Dispose() }
        if ($null -ne $stream) { $stream.Dispose() }
    }
}

function Ensure-TVReceiver {
    try {
        Send-Request 'GET' '/status' | Out-Null
    } catch {
        $serial = Get-TVSerial
        & $script:AdbPath -s $serial shell am broadcast -a local.lanoverlay.tv.START -n local.lanoverlay.tv/.BootReceiver 2>&1 | Out-Null
        Start-Sleep -Milliseconds 700
        Send-Request 'GET' '/status' | Out-Null
    }
}

function Configure-TVVSync {
    $enabled = if ($script:VSyncEnabled) { 1 } else { 0 }
    Send-Request 'POST' "/vsync?enabled=$enabled&interval=$($script:VSyncIntervalMs)&transition=$($script:VSyncTransitionMs)" | Out-Null
}

function Configure-TVAudio {
    $globalValue = if ($script:GlobalMuted) { 1 } else { 0 }
    Send-Request 'POST' "/audio-mute?muted=$globalValue" | Out-Null
}

function Notify-MotionStart {
    if (-not $script:Connected -or -not $script:OverlayActive -or -not $script:VSyncEnabled -or
        $null -eq $script:SelectedMediaItem -or -not $script:SelectedMediaItem.RemoteVisible) { return }
    try {
        Send-Request 'POST' "/motion-start?id=$($script:SelectedMediaItem.Id)" | Out-Null
    } catch {
        Set-Status "V-Sync motion tracking failed: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
    }
}

function Save-Config {
    if ($env:MIRROR_TO_TV_SELFTEST -eq '1' -or $env:MIRROR_TO_TV_CONNECTION_TEST -eq '1') { return }
    try {
        Sync-SelectedMediaItem
        $config = [ordered]@{
            tvIp = $ipBox.Text.Trim()
            adbPort = [int]$adbPortBox.Value
            size = [int]$script:OverlaySize
            opacity = [int]$opacitySlider.Value
            x = [double]$script:OverlayX
            y = [double]$script:OverlayY
            dropModeEnabled = [bool]$script:DropModeEnabled
            updatesPerSecond = [int]$updatesPerSecondBox.Value
            vSyncEnabled = [bool]$script:VSyncEnabled
            vSyncIntervalMs = [int]$script:VSyncIntervalMs
            vSyncTransitionMs = [int]$script:VSyncTransitionMs
            globalMuted = [bool]$script:GlobalMuted
            videoMuted = [bool]$script:VideoMuted
            audioLibrary = @($script:AudioLibrary)
            lastImage = $(if ($null -ne $script:SelectedMediaItem) { [string]$script:SelectedMediaItem.Path } else { '' })
        }
        $config | ConvertTo-Json | Set-Content -LiteralPath $script:ConfigPath -Encoding UTF8
    } catch { }
}

function New-MediaPreviewImage([string]$Path) {
    $extension = [System.IO.Path]::GetExtension($Path).ToLowerInvariant()
    if ($extension -in @('.mp4', '.m4v', '.webm', '.mkv', '.3gp')) {
        $kind = 'video'
        $image = $null
        if ($null -ne $script:FfmpegPath) {
            $previewPath = Join-Path ([System.IO.Path]::GetTempPath()) "mirror-to-tv-preview-$([guid]::NewGuid().ToString('N')).png"
            try {
                $arguments = @('-hide_banner', '-loglevel', 'error', '-y', '-ss', '0.2',
                    '-i', $Path, '-frames:v', '1', '-vf',
                    'scale=640:360:force_original_aspect_ratio=decrease', $previewPath)
                & $script:FfmpegPath @arguments 2>&1 | Out-Null
                if ($LASTEXITCODE -eq 0 -and (Test-Path -LiteralPath $previewPath -PathType Leaf)) {
                    $source = [System.Drawing.Image]::FromFile($previewPath)
                    try { $image = New-Object System.Drawing.Bitmap -ArgumentList $source }
                    finally { $source.Dispose() }
                }
            } catch { } finally {
                Remove-Item -LiteralPath $previewPath -Force -ErrorAction SilentlyContinue
            }
        }
        if ($null -eq $image) {
            $image = [System.Drawing.Bitmap]::new(640, 360)
            $placeholderGraphics = [System.Drawing.Graphics]::FromImage($image)
            try {
                $placeholderGraphics.Clear([System.Drawing.Color]::FromArgb(24, 32, 45))
                $videoFont = New-Object System.Drawing.Font('Segoe UI Semibold', 28)
                $videoBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(225, 235, 245))
                try {
                    $placeholderGraphics.DrawString('▶  VIDEO', $videoFont, $videoBrush, 215, 145)
                } finally { $videoFont.Dispose(); $videoBrush.Dispose() }
            } finally { $placeholderGraphics.Dispose() }
        }
    } else {
        $kind = if ($extension -eq '.gif') { 'gif' } else { 'image' }
        $source = [System.Drawing.Image]::FromFile($Path)
        try {
            $image = New-Object System.Drawing.Bitmap -ArgumentList $source
        } finally {
            $source.Dispose()
        }
    }
    return [PSCustomObject]@{
        Image = $image
        Kind = $kind
        Aspect = $image.Width / [double]$image.Height
    }
}

function Sync-SelectedMediaItem {
    if ($null -eq $script:SelectedMediaItem -or $script:ChangingSelection) { return }
    $script:SelectedMediaItem.X = [double]$script:OverlayX
    $script:SelectedMediaItem.Y = [double]$script:OverlayY
    $script:SelectedMediaItem.Size = [int]$script:OverlaySize
    if ($null -ne $opacitySlider) { $script:SelectedMediaItem.Opacity = [int]$opacitySlider.Value }
    $script:SelectedMediaItem.VideoMuted = [bool]$script:VideoMuted
    $script:SelectedMediaItem.VideoPaused = [bool]$script:VideoPaused
}

function Select-MediaItem($Item) {
    $selectionChanged = -not [object]::ReferenceEquals($script:SelectedMediaItem, $Item)
    Sync-SelectedMediaItem
    if ($selectionChanged) { Reset-MoveStream }
    $script:SelectedMediaItem = $Item
    $script:ChangingSelection = $true
    try {
        if ($null -eq $Item) {
            $script:CurrentImage = $null
            $script:LoadedMediaPath = ''
            $script:MediaKind = 'image'
            $script:ImageAspect = 1.0
            $script:VideoMuted = $false
            $script:VideoPaused = $false
            if ($null -ne $fileBox) { $fileBox.Text = '' }
        } else {
            $script:CurrentImage = $Item.Image
            $script:LoadedMediaPath = [string]$Item.Path
            $script:MediaKind = [string]$Item.Kind
            $script:ImageAspect = [double]$Item.Aspect
            $script:OverlayX = [double]$Item.X
            $script:OverlayY = [double]$Item.Y
            $script:VideoMuted = [bool]$Item.VideoMuted
            $script:VideoPaused = [bool]$Item.VideoPaused
            if ($null -ne $fileBox) { $fileBox.Text = [string]$Item.Path }
            $script:OverlaySize = [int]$Item.Size
            if ($null -ne $opacitySlider) { $opacitySlider.Value = [int]$Item.Opacity }
        }
    } finally {
        $script:ChangingSelection = $false
    }
    Clamp-OverlayPosition
    if ($null -ne $screenPreview) { $screenPreview.Invalidate() }
    if ($null -ne $chromaButton) { Update-ChromaButton }
}

function Add-MediaItem([string]$Path, [bool]$AutoTransmit = $true) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw 'The media file was not found.' }
    $previewData = New-MediaPreviewImage $Path
    $cascade = $script:MediaItems.Count % 8
    $item = [PSCustomObject]@{
        Id = "media$($script:NextMediaId)"
        Path = $Path
        Kind = [string]$previewData.Kind
        Image = $previewData.Image
        Aspect = [double]$previewData.Aspect
        X = [Math]::Min(0.72, 0.04 + ($cascade * 0.055))
        Y = [Math]::Min(0.56, 0.04 + ($cascade * 0.045))
        Size = [int]$script:OverlaySize
        Opacity = [int]$opacitySlider.Value
        VideoMuted = $false
        VideoPaused = $false
        ChromaEnabled = $false
        ChromaColor = '00FF00'
        ChromaTolerance = 30
        ChromaSoftness = 8
        ProcessedPath = ''
        ProcessedSignature = ''
        RemoteVisible = $false
    }
    $script:NextMediaId++
    [void]$script:MediaItems.Add($item)
    Select-MediaItem $item
    if ($AutoTransmit -and $script:BroadcastEnabled) { Send-MediaItem $item $false }
    return $item
}

function Load-SelectedMedia([string]$Path, [bool]$ResetVideoMute = $true) {
    $savedX = $script:OverlayX
    $savedY = $script:OverlayY
    $savedVideoMute = $script:VideoMuted
    $item = Add-MediaItem $Path $false
    $item.X = $savedX
    $item.Y = $savedY
    if (-not $ResetVideoMute) { $item.VideoMuted = $savedVideoMute }
    Select-MediaItem $item
}

function Clear-ChromaMediaCache($Item) {
    if ($null -eq $Item -or [string]::IsNullOrWhiteSpace([string]$Item.ProcessedPath)) { return }
    try {
        $cacheRoot = [System.IO.Path]::GetFullPath($script:ChromaCacheDirectory)
        $cachedFile = [System.IO.Path]::GetFullPath([string]$Item.ProcessedPath)
        if ($cachedFile.StartsWith($cacheRoot + [System.IO.Path]::DirectorySeparatorChar,
                [System.StringComparison]::OrdinalIgnoreCase)) {
            Remove-Item -LiteralPath $cachedFile -Force -ErrorAction SilentlyContinue
        }
    } finally {
        $Item.ProcessedPath = ''
    }
}

function Get-MediaItemRectangle($Item) {
    if ($null -eq $Item) { return [System.Drawing.RectangleF]::Empty }
    $screenWidth = [double]$screenPreview.ClientSize.Width
    $screenHeight = [double]$screenPreview.ClientSize.Height
    $width = $screenWidth * ([double]$Item.Size / 100.0)
    $height = $width / [Math]::Max(0.01, [double]$Item.Aspect)
    $maxHeight = $screenHeight
    if ($height -gt $maxHeight) {
        $height = $maxHeight
        $width = $height * [double]$Item.Aspect
    }
    $x = [double]$Item.X * $screenWidth
    $y = [double]$Item.Y * $screenHeight
    return [System.Drawing.RectangleF]::new(
        [single]$x,
        [single]$y,
        [single]$width,
        [single]$height)
}

function Get-OverlayRectangle {
    Sync-SelectedMediaItem
    return Get-MediaItemRectangle $script:SelectedMediaItem
}

function Clamp-OverlayPosition {
    if ($null -eq $screenPreview -or $screenPreview.ClientSize.Width -le 0) { return }
    $rect = Get-OverlayRectangle
    $maxX = [Math]::Max(0.0, 1.0 - ($rect.Width / $screenPreview.ClientSize.Width))
    $maxY = [Math]::Max(0.0, 1.0 - ($rect.Height / $screenPreview.ClientSize.Height))
    $script:OverlayX = [Math]::Max(0.0, [Math]::Min($maxX, $script:OverlayX))
    $script:OverlayY = [Math]::Max(0.0, [Math]::Min($maxY, $script:OverlayY))
    Sync-SelectedMediaItem
    if ($null -ne $positionLabel) {
        $positionLabel.Text = "Selected layer: X $([Math]::Round($script:OverlayX * 100))%  Y $([Math]::Round($script:OverlayY * 100))%"
    }
}

function Mark-PositionDirty {
    Sync-SelectedMediaItem
    $script:PositionRevision++
    $script:PositionDirty = $true
}

function Get-DesiredMoveIntervalMs {
    if ($script:VSyncEnabled) { return [int]$script:VSyncIntervalMs }
    $requestedRate = [Math]::Max(1, [int]$updatesPerSecondBox.Value)
    return [double](1000.0 / $requestedRate)
}

function Get-MonotonicMilliseconds {
    return [long]$script:MoveClock.ElapsedMilliseconds
}

function Start-PreviewDrag([double]$X, [double]$Y) {
    if ($null -eq $script:CurrentImage) { return $false }
    $rect = Get-OverlayRectangle
    if (-not $rect.Contains([single]$X, [single]$Y)) { return $false }
    $script:Dragging = $true
    $script:DragOffset = [System.Drawing.PointF]::new(
        [single]($X - $rect.X),
        [single]($Y - $rect.Y))
    return $true
}

function Update-PreviewDrag([double]$X, [double]$Y) {
    if (-not $script:Dragging) { return $false }
    $script:OverlayX = ($X - $script:DragOffset.X) / [double]$screenPreview.ClientSize.Width
    $script:OverlayY = ($Y - $script:DragOffset.Y) / [double]$screenPreview.ClientSize.Height
    Clamp-OverlayPosition
    Mark-PositionDirty
    $screenPreview.Invalidate()
    if ($script:Connected) { Pump-MoveStream $false }
    return $true
}

function Get-ResizeHandle([double]$X, [double]$Y) {
    if ($null -eq $script:CurrentImage) { return '' }
    $rect = Get-OverlayRectangle
    $radius = 13.0
    $radiusSquared = $radius * $radius
    $handles = @(
        @('top-left', $rect.Left, $rect.Top),
        @('top-right', $rect.Right, $rect.Top),
        @('bottom-left', $rect.Left, $rect.Bottom),
        @('bottom-right', $rect.Right, $rect.Bottom)
    )
    foreach ($handle in $handles) {
        $deltaX = $X - [double]$handle[1]
        $deltaY = $Y - [double]$handle[2]
        if (($deltaX * $deltaX) + ($deltaY * $deltaY) -le $radiusSquared) {
            return [string]$handle[0]
        }
    }
    return ''
}

function Start-PreviewResize([string]$Corner) {
    if ([string]::IsNullOrWhiteSpace($Corner) -or $null -eq $script:CurrentImage) { return $false }
    $rect = Get-OverlayRectangle
    switch ($Corner) {
        'top-left'     { $anchorX = $rect.Right; $anchorY = $rect.Bottom }
        'top-right'    { $anchorX = $rect.Left;  $anchorY = $rect.Bottom }
        'bottom-left'  { $anchorX = $rect.Right; $anchorY = $rect.Top }
        'bottom-right' { $anchorX = $rect.Left;  $anchorY = $rect.Top }
        default { return $false }
    }
    $script:Resizing = $true
    $script:ResizeCorner = $Corner
    $script:ResizeAnchor = [System.Drawing.PointF]::new([single]$anchorX, [single]$anchorY)
    return $true
}

function Update-PreviewResize([double]$X, [double]$Y) {
    if (-not $script:Resizing) { return $false }
    $leftCorner = $script:ResizeCorner -like '*left'
    $topCorner = $script:ResizeCorner -like 'top-*'
    $signX = if ($leftCorner) { -1.0 } else { 1.0 }
    $signY = if ($topCorner) { -1.0 } else { 1.0 }
    $aspect = [Math]::Max(0.05, $script:ImageAspect)
    $orientedX = $signX * ($X - $script:ResizeAnchor.X)
    $orientedY = $signY * ($Y - $script:ResizeAnchor.Y)
    $projectedWidth = ($orientedX + ($orientedY / $aspect)) / (1.0 + (1.0 / ($aspect * $aspect)))

    $screenWidth = [double]$screenPreview.ClientSize.Width
    $screenHeight = [double]$screenPreview.ClientSize.Height
    $maximumWidth = [Math]::Min($screenWidth, $screenHeight * $aspect)
    $projectedWidth = [Math]::Max($screenWidth * 0.01, [Math]::Min($maximumWidth, $projectedWidth))
    $newPercent = [int][Math]::Round(($projectedWidth / $screenWidth) * 100.0)
    $script:OverlaySize = [Math]::Max(1, [Math]::Min(100, $newPercent))
    Sync-SelectedMediaItem

    $actualRect = Get-OverlayRectangle
    $newX = if ($leftCorner) { $script:ResizeAnchor.X - $actualRect.Width } else { $script:ResizeAnchor.X }
    $newY = if ($topCorner) { $script:ResizeAnchor.Y - $actualRect.Height } else { $script:ResizeAnchor.Y }
    $script:OverlayX = $newX / $screenWidth
    $script:OverlayY = $newY / $screenHeight
    Clamp-OverlayPosition
    Mark-PositionDirty
    $screenPreview.Invalidate()
    if ($script:Connected) { Pump-MoveStream $false }
    return $true
}

function Get-VideoMuteRectangle {
    param($Item = $script:SelectedMediaItem)
    if ($null -eq $Item -or $Item.Kind -ne 'video' -or $null -eq $Item.Image) {
        return [System.Drawing.RectangleF]::Empty
    }
    $rect = Get-MediaItemRectangle $Item
    $buttonSize = [Math]::Max(20.0, [Math]::Min(32.0, [Math]::Min($rect.Width, $rect.Height) * 0.28))
    return [System.Drawing.RectangleF]::new(
        [single]($rect.Left + 7.0),
        [single]($rect.Top + 7.0),
        [single]$buttonSize,
        [single]$buttonSize)
}

function Get-DeleteRectangle {
    param($Item = $script:SelectedMediaItem)
    if ($null -eq $Item) { return [System.Drawing.RectangleF]::Empty }
    $rect = Get-MediaItemRectangle $Item
    $buttonSize = [Math]::Max(18.0, [Math]::Min(22.0, [Math]::Min($rect.Width, $rect.Height) * 0.18))
    $buttonX = $rect.Right + 6.0
    if ($buttonX + $buttonSize -gt $screenPreview.ClientSize.Width - 2) {
        $buttonX = $screenPreview.ClientSize.Width - $buttonSize - 2
    }
    $buttonY = [Math]::Max(2.0, $rect.Top - ($buttonSize * 0.48))
    return [System.Drawing.RectangleF]::new(
        [single]$buttonX,
        [single]$buttonY,
        [single]$buttonSize,
        [single]$buttonSize)
}

function Get-MediaItemAtPoint([double]$X, [double]$Y) {
    for ($index = $script:MediaItems.Count - 1; $index -ge 0; $index--) {
        $item = $script:MediaItems[$index]
        $rect = Get-MediaItemRectangle $item
        if ($rect.Contains([single]$X, [single]$Y)) { return $item }
    }
    return $null
}

function Remove-MediaItem($Item) {
    if ($null -eq $Item) { return }
    if ($script:Connected -and $Item.RemoteVisible) {
        try { Send-Request 'POST' "/delete-media?id=$($Item.Id)" | Out-Null }
        catch { Set-Status "The layer was removed locally. The TV watchdog will remove it automatically: $($_.Exception.Message)" ([System.Drawing.Color]::FromArgb(180, 95, 35)) }
    }
    $wasSelected = $script:SelectedMediaItem -eq $Item
    [void]$script:MediaItems.Remove($Item)
    if ($wasSelected) {
        $nextItem = if ($script:MediaItems.Count -gt 0) { $script:MediaItems[$script:MediaItems.Count - 1] } else { $null }
        Select-MediaItem $nextItem
    }
    if ($null -ne $Item.Image) { $Item.Image.Dispose() }
    Clear-ChromaMediaCache $Item
    $script:OverlayActive = @($script:MediaItems | Where-Object { $_.RemoteVisible }).Count -gt 0
    Reset-MoveStream
    $screenPreview.Invalidate()
    Save-Config
    Set-Status 'Layer removed from the preview and TV.' ([System.Drawing.Color]::FromArgb(70, 78, 92))
}

function Update-GlobalMuteUI {
    if ($script:GlobalMuted) {
        $globalMuteButton.Text = 'Global audio: Muted'
        $globalMuteButton.BackColor = [System.Drawing.Color]::FromArgb(76, 27, 42)
        $globalMuteButton.FlatAppearance.BorderColor = $script:ThemeDanger
    } else {
        $globalMuteButton.Text = 'Global audio: On'
        $globalMuteButton.BackColor = [System.Drawing.Color]::FromArgb(18, 72, 62)
        $globalMuteButton.FlatAppearance.BorderColor = $script:ThemeSuccess
    }
    $globalMuteButton.ForeColor = [System.Drawing.Color]::White
}

function Toggle-GlobalMute([bool]$LocalOnly = $false) {
    $script:GlobalMuted = -not $script:GlobalMuted
    Update-GlobalMuteUI
    if ($LocalOnly) {
        Save-Config
        return
    }
    $temporaryTunnel = -not $script:Connected
    try {
        if ($temporaryTunnel) {
            Open-AdbTunnel
            Ensure-TVReceiver
        }
        $mutedValue = if ($script:GlobalMuted) { 1 } else { 0 }
        Send-Request 'POST' "/audio-mute?muted=$mutedValue" | Out-Null
        $message = if ($script:GlobalMuted) {
            'Global audio is muted. Audio tracks and video audio are silent.'
        } else {
            'Global audio is enabled. Audio tracks and unmuted videos are audible.'
        }
        Set-Status $message ([System.Drawing.Color]::FromArgb(70, 78, 92))
    } catch {
        Set-Status "The mute setting was saved locally, but the TV is unavailable: $($_.Exception.Message)" ([System.Drawing.Color]::FromArgb(180, 95, 35))
    } finally {
        if ($temporaryTunnel) { Close-AdbTunnel }
    }
    Save-Config
}

function Toggle-VideoMute {
    if ($script:MediaKind -ne 'video' -or $null -eq $script:SelectedMediaItem) { return }
    $script:VideoMuted = -not $script:VideoMuted
    Sync-SelectedMediaItem
    $screenPreview.Invalidate()
    try {
        if ($script:Connected -and $script:SelectedMediaItem.RemoteVisible) {
            $mutedValue = if ($script:VideoMuted) { 1 } else { 0 }
            Send-Request 'POST' "/video-mute?id=$($script:SelectedMediaItem.Id)&muted=$mutedValue" | Out-Null
        }
        $message = if ($script:VideoMuted) {
            'Audio is muted for the selected video. Audio library playback is unchanged.'
        } else {
            'Audio is enabled for the selected video unless global audio is muted.'
        }
        Set-Status $message ([System.Drawing.Color]::FromArgb(70, 78, 92))
    } catch {
        Set-Status "Could not change video audio: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
    }
    Save-Config
}

function Get-PreviewCursor([double]$X, [double]$Y) {
    foreach ($item in @($script:MediaItems)) {
        $deleteRectangle = Get-DeleteRectangle $item
        $muteRectangle = Get-VideoMuteRectangle $item
        if ((-not $deleteRectangle.IsEmpty -and $deleteRectangle.Contains([single]$X, [single]$Y)) -or
            (-not $muteRectangle.IsEmpty -and $muteRectangle.Contains([single]$X, [single]$Y))) {
            return [System.Windows.Forms.Cursors]::Hand
        }
    }
    $handle = Get-ResizeHandle $X $Y
    if ($handle -in @('top-left', 'bottom-right')) { return [System.Windows.Forms.Cursors]::SizeNWSE }
    if ($handle -in @('top-right', 'bottom-left')) { return [System.Windows.Forms.Cursors]::SizeNESW }
    if ($null -ne (Get-MediaItemAtPoint $X $Y)) { return [System.Windows.Forms.Cursors]::Hand }
    return [System.Windows.Forms.Cursors]::Default
}

function Move-Preset([string]$Horizontal, [string]$Vertical) {
    $rect = Get-OverlayRectangle
    $widthFraction = $rect.Width / $screenPreview.ClientSize.Width
    $heightFraction = $rect.Height / $screenPreview.ClientSize.Height
    $margin = 0.025
    if ($Horizontal -eq 'left') { $script:OverlayX = $margin }
    elseif ($Horizontal -eq 'right') { $script:OverlayX = 1.0 - $widthFraction - $margin }
    else { $script:OverlayX = (1.0 - $widthFraction) / 2.0 }
    if ($Vertical -eq 'top') { $script:OverlayY = $margin }
    elseif ($Vertical -eq 'bottom') { $script:OverlayY = 1.0 - $heightFraction - $margin }
    else { $script:OverlayY = (1.0 - $heightFraction) / 2.0 }
    Clamp-OverlayPosition
    $screenPreview.Invalidate()
    Mark-PositionDirty
    if ($script:Connected) { Queue-FinalMove }
}

function Complete-MoveRequestIfReady {
    if ($null -eq $script:MoveTask -or -not $script:MoveTask.IsCompleted) { return }

    $response = $null
    try {
        $response = $script:MoveTask.GetAwaiter().GetResult()
        if (-not $response.IsSuccessStatusCode) {
            throw "The TV returned error $([int]$response.StatusCode)."
        }
        $script:MoveFailures = 0
        $script:MoveRequestsSucceeded++
        if ($script:PositionRevision -le $script:MoveSentRevision) {
            $script:PositionDirty = $false
        } else {
            $script:PositionDirty = $true
        }
    } catch {
        $script:MoveFailures++
        $script:PositionDirty = $true
        if ($script:DropModeEnabled) { $script:ForceMovePending = $true }
        $backoffMs = [Math]::Max((Get-DesiredMoveIntervalMs), [Math]::Min(2000, 200 * $script:MoveFailures))
        $script:MoveNextAllowedAt = (Get-MonotonicMilliseconds) + $backoffMs
        if ($script:MoveFailures -ge 3 -and -not $script:Closing) {
            Set-Status "Position updates are delayed. Retrying the latest position: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
        }
    } finally {
        if ($null -ne $response) { $response.Dispose() }
        if ($null -ne $script:MoveRequest) { $script:MoveRequest.Dispose() }
        $script:MoveRequest = $null
        $script:MoveTask = $null
    }
}

function Start-MoveRequest([bool]$Forced) {
    if ($null -eq $script:SelectedMediaItem -or -not $script:SelectedMediaItem.RemoteVisible) { return }
    Sync-SelectedMediaItem
    $x = [Math]::Round($script:OverlayX * 1000)
    $y = [Math]::Round($script:OverlayY * 1000)
    $width = $script:OverlaySize * 10
    $opacity = $opacitySlider.Value
    $url = "http://127.0.0.1:$script:LocalTunnelPort/move?id=$($script:SelectedMediaItem.Id)&x=$x&y=$y&w=$width&opacity=$opacity"
    $request = New-Object System.Net.Http.HttpRequestMessage(
        [System.Net.Http.HttpMethod]::Post, $url)
    $request.Content = New-Object System.Net.Http.ByteArrayContent -ArgumentList (,[byte[]]@())
    $script:MoveRequest = $request
    $script:MoveSentRevision = $script:PositionRevision
    $script:MoveNextAllowedAt = (Get-MonotonicMilliseconds) + (Get-DesiredMoveIntervalMs)
    $script:MoveRequestsStarted++
    if ($env:MIRROR_TO_TV_STREAM_TEST -eq '1') { $script:MoveRequestTimes += (Get-MonotonicMilliseconds) }
    if ($Forced) { $script:ForceMovePending = $false }
    try {
        $script:MoveTask = $moveHttp.SendAsync($request)
    } catch {
        $request.Dispose()
        $script:MoveRequest = $null
        $script:MoveTask = $null
        $script:MoveFailures++
        $script:PositionDirty = $true
        if ($Forced) { $script:ForceMovePending = $true }
    }
}

function Pump-MoveStream([bool]$Force = $false) {
    Complete-MoveRequestIfReady
    if ($null -ne $script:MoveTask -or -not $script:Connected -or -not $script:OverlayActive -or
        $null -eq $script:SelectedMediaItem -or -not $script:SelectedMediaItem.RemoteVisible -or
        $script:Closing -or -not $script:PositionDirty) { return }
    if ($script:DropModeEnabled -and -not $Force) { return }
    if (-not $Force -and (Get-MonotonicMilliseconds) -lt $script:MoveNextAllowedAt) { return }
    Start-MoveRequest $Force
}

function Queue-FinalMove {
    if (-not $script:Connected -or -not $script:OverlayActive) { return }
    $script:ForceMovePending = $true
    Pump-MoveStream $true
}

function Reset-MoveStream {
    try { $moveHttp.CancelPendingRequests() } catch { }
    if ($null -ne $script:MoveRequest) {
        try { $script:MoveRequest.Dispose() } catch { }
    }
    $script:MoveRequest = $null
    $script:MoveTask = $null
    $script:MoveNextAllowedAt = 0L
    $script:ForceMovePending = $false
    $script:PositionDirty = $false
}

function Send-MoveUpdate([bool]$Quiet = $true) {
    if (-not $script:Connected -or $null -eq $script:SelectedMediaItem -or -not $script:SelectedMediaItem.RemoteVisible) { return }
    Sync-SelectedMediaItem
    $x = [Math]::Round($script:OverlayX * 1000)
    $y = [Math]::Round($script:OverlayY * 1000)
    $width = $script:OverlaySize * 10
    $opacity = $opacitySlider.Value
    try {
        Send-Request 'POST' "/move?id=$($script:SelectedMediaItem.Id)&x=$x&y=$y&w=$width&opacity=$opacity" | Out-Null
        $script:PositionDirty = $false
        $script:MoveFailures = 0
    } catch {
        $script:MoveFailures++
        if (-not $Quiet -or $script:MoveFailures -ge 3) {
            Set-Status "Could not send the layer position: $($_.Exception.Message)" ([System.Drawing.Color]::Firebrick)
        }
    }
}

